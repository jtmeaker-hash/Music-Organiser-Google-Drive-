# Music Vault Manager - Environment Configuration Template
# Copy this file to ~/.config/musicvault/.env or populate via the setup wizard:
#   python -m musicvault setup

# ==========================================
# External Music Metadata API Credentials
# ==========================================
# SonoVault API Key (BPM, Key, Genre)
SONOVAULT_API_KEY=

# AudioMeta API Key (Acoustic features, BPM, Key)
AUDIOMETA_API_KEY=

# Discogs Personal Access Token (Release info, genres, styles, labels)
DISCOGS_TOKEN=

# ==========================================
# Google Drive & Sheets Library Identifiers
# ==========================================
# Source incoming music folder ID on Google Drive
SOURCE_FOLDER_ID=1m5jXhGCESHVcwXbAgAcbuuAPVI0Dt7j_

# Vault organized destination folder ID on Google Drive
VAULT_FOLDER_ID=1qqzURCAV4CYCs1xmYHQv0nZXhmfLCxmi

# Google Sheets Master Track Index spreadsheet ID
SHEET_ID=1Dl1UR35uyEC0g7lHKYL1gEbxu7LV2I1t6mHw2QSWUPE

# MusicBrainz User-Agent contact URL/email
MUSICBRAINZ_CONTACT=https://github.com/jtmeaker-hash/Music-Organiser-Google-Drive-

# ==========================================
# Application Settings
# ==========================================
# Safety: Dry run by default (True/False)
DRY_RUN=True

# Allow provisional moves when explicit opt-in is granted (True/False)
ALLOW_PROVISIONAL_MOVES=False

# Provider terms cleared for metadata persistence (True/False)
PROVIDER_TERMS_CLEARED=False

# Path to Google OAuth client secrets file (if using custom credentials)
GOOGLE_CLIENT_SECRETS_FILE=~/.config/musicvault/client_secrets.json

# Unified processing only. Standalone research retains its existing selection defaults.
SONOVAULT_MODE=fallback
# FALLBACK_RESEARCH_PROVIDERS=audiometa
# REQUIRED_RESEARCH_PROVIDERS=musicbrainz,discogs
# PROVIDER_PRIORITY_JSON={"bpm":["audiometa","sonovault"],"genre":["musicbrainz","discogs"]}
# PROVIDER_BREAKER_JSON={"consecutive":3,"window":10,"rate":0.6,"batch_min":5,"batch_rate":0.6,"cooldown":300,"max_cooldown":3600}
